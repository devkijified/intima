# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Supabase project URL (Supabase dashboard, Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for client side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key. Server side ONLY. Never expose to the browser
# and never commit it. Rotate it in the dashboard if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY are server side only (Vercel env vars).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is the same public key, baked into the client
# at build time, so it must also be set in Vercel env vars before deploying.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
