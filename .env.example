# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Supabase project URL (Supabase dashboard, Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for client side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key. Server side ONLY. Never expose to the browser
# and never commit it. Rotate it in the dashboard if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000
